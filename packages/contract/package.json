{
  "name": "@purrshelf/contract",
  "version": "0.0.0",
  "private": true,
  "description": "Broker API contract: Zod schemas, endpoint map, OpenAPI document and typed client.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "openapi": "tsx scripts/generate-openapi.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@purrshelf/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
