{
  "openapi": "3.1.0",
  "info": {
    "title": "Purrshelf broker API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health",
        "summary": "Liveness and dependency checks",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Username + password → access and refresh token",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "refresh",
        "summary": "Rotate the refresh token",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Revoke the refresh token",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Empty"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "me",
        "summary": "Current user, locale and Kobo state",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/budget": {
      "get": {
        "operationId": "budget",
        "summary": "Per indexer: searches and grabs left in the rolling hour, and the next free slot",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Budget"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/discover/search": {
      "get": {
        "operationId": "discoverSearch",
        "summary": "Search book metadata (Hardcover, Open Library, Google Books). Never spends an indexer search.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoverSearchResult"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "name": "author",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "default": "any",
              "type": "string",
              "enum": ["any", "en", "nl"]
            }
          }
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/works/{id}": {
      "get": {
        "operationId": "work",
        "summary": "Details of one work, with library state",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkDetail"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(hardcover|openlibrary|googlebooks):[A-Za-z0-9_-]{1,64}$"
            }
          }
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/works/{id}/series": {
      "get": {
        "operationId": "workSeries",
        "summary": "The series a work belongs to, in reading order",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkSeries"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(hardcover|openlibrary|googlebooks):[A-Za-z0-9_-]{1,64}$"
            }
          }
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/works/{id}/similar": {
      "get": {
        "operationId": "workSimilar",
        "summary": "Similar books: same series, then same author, then subject. Metadata only.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimilarWorks"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(hardcover|openlibrary|googlebooks):[A-Za-z0-9_-]{1,64}$"
            }
          }
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Budget": {
        "type": "object",
        "properties": {
          "windowMinutes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "searches": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "left": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "nextFreeAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["limit", "left", "nextFreeAt"],
            "additionalProperties": false
          },
          "indexers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IndexerBudget"
            }
          }
        },
        "required": ["windowMinutes", "searches", "indexers"],
        "additionalProperties": false
      },
      "DiscoverSearchResult": {
        "type": "object",
        "properties": {
          "hits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkSummary"
            }
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": ["hardcover", "openlibrary", "googlebooks"]
                },
                "status": {
                  "type": "string",
                  "enum": ["ok", "failed", "skipped"]
                }
              },
              "required": ["provider", "status"],
              "additionalProperties": false
            }
          }
        },
        "required": ["hits", "providers"],
        "additionalProperties": false
      },
      "Empty": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_ERROR",
              "UNAUTHORIZED",
              "INVALID_CREDENTIALS",
              "ACCOUNT_LOCKED",
              "INVALID_REFRESH_TOKEN",
              "RATE_LIMITED",
              "NOT_FOUND",
              "METADATA_UNAVAILABLE",
              "INTERNAL_ERROR"
            ]
          },
          "message": {
            "type": "string"
          },
          "details": {}
        },
        "required": ["code", "message"],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "const": "purrshelf-broker"
          },
          "status": {
            "type": "string",
            "enum": ["ok", "degraded"]
          },
          "version": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": ["ok", "fail"]
                },
                "error": {
                  "type": "string"
                }
              },
              "required": ["name", "status"],
              "additionalProperties": false
            }
          }
        },
        "required": ["service", "status", "version", "checks"],
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": ["username", "password"],
        "additionalProperties": false
      },
      "LogoutRequest": {
        "$ref": "#/components/schemas/RefreshRequest"
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "locale": {
            "type": "string",
            "enum": ["en", "nl"]
          },
          "kobo": {
            "type": "object",
            "properties": {
              "configured": {
                "type": "boolean"
              }
            },
            "required": ["configured"],
            "additionalProperties": false
          }
        },
        "required": ["id", "username", "displayName", "locale", "kobo"],
        "additionalProperties": false
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["refreshToken"],
        "additionalProperties": false
      },
      "SimilarWorks": {
        "type": "object",
        "properties": {
          "works": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string",
                  "enum": ["series", "author", "subject"]
                },
                "work": {
                  "$ref": "#/components/schemas/WorkSummary"
                }
              },
              "required": ["reason", "work"],
              "additionalProperties": false
            }
          }
        },
        "required": ["works"],
        "additionalProperties": false
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresIn": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresIn",
          "refreshToken",
          "refreshTokenExpiresAt"
        ],
        "additionalProperties": false
      },
      "WorkDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(hardcover|openlibrary|googlebooks):[A-Za-z0-9_-]{1,64}$"
          },
          "mediaType": {
            "type": "string",
            "enum": ["ebook", "audiobook"]
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": ["string", "null"]
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "language": {
            "type": ["string", "null"]
          },
          "series": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": ["string", "null"]
                  },
                  "name": {
                    "type": "string"
                  },
                  "position": {
                    "type": ["number", "null"]
                  },
                  "total": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["id", "name", "position", "total"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "publishedYear": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "isbns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hasCover": {
            "type": "boolean"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": ["hardcover", "openlibrary", "googlebooks"]
                },
                "id": {
                  "type": "string"
                }
              },
              "required": ["provider", "id"],
              "additionalProperties": false
            }
          },
          "library": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LibraryState"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": ["string", "null"]
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pageCount": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "mediaType",
          "title",
          "subtitle",
          "authors",
          "language",
          "series",
          "publishedYear",
          "isbns",
          "hasCover",
          "sources",
          "library",
          "description",
          "subjects",
          "pageCount"
        ],
        "additionalProperties": false
      },
      "WorkSeries": {
        "type": "object",
        "properties": {
          "series": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": ["string", "null"]
                  },
                  "name": {
                    "type": "string"
                  },
                  "total": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["id", "name", "total"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "position": {
                  "type": ["number", "null"]
                },
                "work": {
                  "$ref": "#/components/schemas/WorkSummary"
                }
              },
              "required": ["position", "work"],
              "additionalProperties": false
            }
          }
        },
        "required": ["series", "entries"],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
