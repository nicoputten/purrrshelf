{
  "name": "@purrshelf/broker",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted broker: the only service that spends indexer calls and drives SABnzbd and the library.",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "cli": "tsx src/cli-main.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.2",
    "@node-rs/argon2": "^2.2.2",
    "@purrshelf/contract": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@purrshelf/config": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "bin": {
    "purrshelf": "dist/cli-main.js"
  }
}
