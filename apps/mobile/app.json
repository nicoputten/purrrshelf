{
  "expo": {
    "name": "Purrshelf",
    "slug": "purrshelf",
    "scheme": "purrshelf",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#17141C",
    "android": {
      "package": "app.purrshelf",
      "adaptiveIcon": {
        "backgroundColor": "#2E2836",
        "foregroundImage": "./assets/icon/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/icon/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#17141C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/icon/favicon.png"
    }
  }
}
