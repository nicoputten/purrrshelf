# Purrshelf broker configuration.
# Copy to .env (git-ignored) and fill in real values on the server only.
# Every value below is a placeholder. Never commit real keys, passwords,
# host names or IP addresses.

# --- Server -----------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# SQLite database file on the /data volume.
DATABASE_PATH=/data/purrshelf.db
# Peers allowed to set X-Forwarded-For (ADR 0018). The default trusts private
# networks, where Nginx Proxy Manager runs. Narrow it to the proxy's address or
# subnet if you like; `none` trusts nobody. `true` is refused.
TRUST_PROXY=loopback,linklocal,uniquelocal

# --- Auth (milestone 1) -----------------------------------------------------
# At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Calibre-Web-Automated (milestone 3) ------------------------------------
# CWA v4.0.8. The service account is created by hand before milestone 3.
CWA_BASE_URL=http://cwa.example.invalid:8083
CWA_SERVICE_USER=change-me
CWA_SERVICE_PASSWORD=change-me
# Name of each reader's own Kobo shelf; IDs are looked up per user at runtime.
CWA_KOBO_SHELF_NAME=Kobo
# Same datasets as CWA's /calibre-library and /cwa-book-ingest, mounted in the broker.
CALIBRE_LIBRARY_PATH=/calibre-library
CWA_INGEST_PATH=/cwa-book-ingest
CWA_CONFIG_PATH=/cwa-config

# --- SABnzbd (milestone 4) --------------------------------------------------
SABNZBD_URL=http://sabnzbd.example.invalid:8080
SABNZBD_API_KEY=00000000000000000000000000000000
SABNZBD_CATEGORY=kobopush
# SABnzbd's kobopush complete folder, mounted read-only in the broker.
DOWNLOADS_PATH=/downloads
DOWNLOAD_POLL_SECONDS=15
# How long to wait for CWA to show an ingested book before import_failed.
IMPORT_TIMEOUT_MINUTES=30
MAX_BOOK_MB=50

# --- Indexers (milestone 4) -------------------------------------------------
# Indexer URL and limits live in the database; only the key comes from env,
# one variable per indexer id: INDEXER_<ID>_API_KEY
INDEXER_PRIMARY_API_KEY=00000000000000000000000000000000

# --- Metadata providers (milestone 2) ---------------------------------------
# Hardcover (best data, searched first). Token from hardcover.app → Settings →
# API; with or without the "Bearer " prefix. Empty or change-me skips Hardcover.
# Tokens expire after a year: /health turns "degraded" 30 days before.
HARDCOVER_API_TOKEN=change-me
HARDCOVER_TOKEN_WARN_DAYS=30
# Optional: Google Books works without a key, at a lower shared quota.
GOOGLE_BOOKS_API_KEY=change-me
# Provider replies are cached in the database for this many days.
METADATA_CACHE_DAYS=7
METADATA_TIMEOUT_MS=8000
# Downloaded covers, three sizes each, on the /data volume.
COVERS_PATH=/data/covers

# --- In-app updates (milestone 9) -------------------------------------------
# GitHub repository (owner/name) whose mobile-v* releases carry the app's APK.
# The broker only asks GitHub when the app checks for an update, at most once
# per APP_UPDATE_CHECK_MINUTES. change-me or empty turns updates off.
APP_RELEASES_REPO=change-me
APP_UPDATE_CHECK_MINUTES=60
# The downloaded APK, on the /data volume.
APP_UPDATES_PATH=/data/app-updates
MAX_APK_MB=200
