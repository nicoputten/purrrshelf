# Purrshelf broker configuration.
# Copy to .env (git-ignored) and fill in real values on the server only.
# Every value below is a placeholder. Never commit real keys, passwords,
# host names or IP addresses.

# --- Server -----------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# SQLite database file on the /data volume.
DATABASE_PATH=/data/purrshelf.db

# --- Auth (milestone 1) -----------------------------------------------------
# At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Calibre-Web-Automated (milestone 3) ------------------------------------
CWA_URL=http://cwa.example.invalid:8083
CWA_USERNAME=change-me
CWA_PASSWORD=change-me
CALIBRE_LIBRARY_PATH=/calibre-library
CWA_CONFIG_PATH=/cwa-config
CWA_INGEST_PATH=/ingest

# --- SABnzbd (milestone 4) --------------------------------------------------
SABNZBD_URL=http://sabnzbd.example.invalid:8080
SABNZBD_API_KEY=00000000000000000000000000000000
SABNZBD_CATEGORY=kobopush
DOWNLOADS_PATH=/downloads

# --- Indexers (milestone 4) -------------------------------------------------
# Indexer URL and limits live in the database; only the key comes from env,
# one variable per indexer id: INDEXER_<ID>_API_KEY
INDEXER_PRIMARY_API_KEY=00000000000000000000000000000000

# --- Metadata providers (milestone 2) ---------------------------------------
HARDCOVER_API_TOKEN=change-me
GOOGLE_BOOKS_API_KEY=change-me
